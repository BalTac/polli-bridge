# --- Pollinations credentials -------------------------------------------------
# Your own secret key (sk_...). Get one at https://enter.pollinations.ai/keys
# Never commit a real key. Never put this file in a public repo.
POLLINATIONS_API_TOKEN=

# --- Server -------------------------------------------------------------------
# Bind address. Default 127.0.0.1 = only this machine.
# Use 0.0.0.0 only on a trusted LAN and only with LOCAL_API_TOKEN set.
SERVER_HOST=127.0.0.1
SERVER_PORT=8083
LOG_LEVEL=INFO

# --- Security (strongly recommended on any non-loopback bind) -----------------
# If set, every endpoint requires "X-API-Key: <token>" or "Authorization: Bearer <token>".
# /health, /docs, /redoc and /swagger stay open.
LOCAL_API_TOKEN=

# --- Upstream -----------------------------------------------------------------
POLLINATIONS_API_BASE_URL=https://gen.pollinations.ai
POLLINATIONS_REFERRER=polli-bridge/2.0.0

# --- Audio / TTS --------------------------------------------------------------
# Tier affects how many characters the TTS pipeline sends per request.
POLLINATIONS_TIER=seed
TTS_ENHANCE_TEXT_DEFAULT=true
TTS_CHUNK_MAX_CHARS=0
