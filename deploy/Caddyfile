{
	admin off
	email admin@bot.nu
	storage file_system /data
	log {
		level INFO
	}
}

aibridge.bot.nu {
	encode zstd gzip

	log {
		output file /var/log/caddy/access.log {
			roll_size 20MiB
			roll_keep 5
		}
		# Privacy: il path va nei log, la query string no. Senza questo filtro un
		# GET /generate?prompt=... scriverebbe il prompt su disco.
		format filter {
			wrap json
			request>uri regexp "^([^?]+)\?.*$" "${1}"
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}

	# API: tutto quello che non e' un file statico.
	# Rate limit: 60 richieste/minuto sostenute + 20 di burst = 80 eventi in
	# una finestra scorrevole di 60 s, per IP mascherato lato collector.
	# Il plugin risponde 429 con Retry-After quando la finestra e' piena.
	@api path /v1/* /alpha/* /generate /models/* /account/* /text/* /audio/* /video/* /3d/* /docs* /redoc* /openapi.json /health /swagger
	handle @api {
		rate_limit {
			zone api_per_ip {
				key {remote_host}
				events 80
				window 1m
			}
		}
		request_body {
			max_size 25MB
		}
		reverse_proxy polli-bridge:8083 {
			transport http {
				dial_timeout 5s
				response_header_timeout 300s
			}
		}
	}

	# Tutto il resto: landing, llms.txt, /.well-known/, statistiche.
	handle {
		# route = ordine di esecuzione letterale. Con i direttivi sciolti Caddy mette
		# try_files (rewrite) PRIMA di respond, e la rewrite verso /index.html fa
		# sparire il path da cercare: la regola 404 non scatterebbe mai.
		route {
			root * /srv/site

			# Il ponte marca le risposte API con X-Polli-Auth; il sito statico lo fa qui,
			# cosi' il collector non deve indovinare: ogni riga di log ha la sua categoria.
			header X-Polli-Auth static

			# Igiene: 404 per dotfiles e file di backup, cosi' /.env e /.git/config non
			# ricevono index.html con 200. .well-known resta servito: non matcha.
			@hidden path_regexp hidden (?i)(^|/)\.(env|git|svn|ht|ds_store)|\.bak(-|$)
			respond @hidden 404

			try_files {path} {path}.html {path}/ /index.html
			file_server
		}
	}
}

# Webmail: esposto sulla stessa identita' TLS (aibridge.bot.nu) su porta 8443,
# in attesa che webmail.bot.nu abbia un record DNS proprio.
https://aibridge.bot.nu:8443 {
	log {
		output file /var/log/caddy/webmail.log {
			roll_size 10MiB
			roll_keep 3
		}
		format json
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "no-referrer"
		-Server
	}
	# Il pannello admin di SnappyMail si apre su ?admin: se nessuno ha impostato
	# una password, il primo che passa la imposta. Meglio chiuderlo.
	@adminpanel query admin=*
	respond @adminpanel 403

	reverse_proxy snappymail:8888
}
